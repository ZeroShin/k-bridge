# Visual Studio 2015 user specific files
kbr/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
kbr/SourceArt/**/*.png
kbr/SourceArt/**/*.tga

# Binary Files
kbr/Binaries/*
kbr/Plugins/**/Binaries/*

# Builds
kbr/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!kbr/Build/*/
kbr/Build/*/**
!kbr/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!kbr/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
kbr/Saved/*

# Compiled source files for the engine to use
kbr/Intermediate/*
kbr/Plugins/**/Intermediate/*

# Cache files for the editor to use
kbr/DerivedDataCache/*